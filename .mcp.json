{
  "mcpServers": {
    "better-t-stack": {
      "command": "bunx",
      "args": ["create-better-t-stack@latest", "mcp"]
    },
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    },
    "better-auth": {
      "type": "http",
      "url": "https://mcp.better-auth.com/mcp"
    },
    "pencil": {
      "type": "stdio",
      "command": "/mnt/d/Program Files/Pen/resources/app.asar.unpacked/out/mcp-server-windows-x64.exe",
      "args": ["--app", "desktop"],
      "env": {}
    }
  }
}
