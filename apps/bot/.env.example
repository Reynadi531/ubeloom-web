NODE_ENV=development

# Matches docker-compose.dev.yml (bun run infra:start)
DATABASE_URL=postgresql://postgres:password@localhost:5432/web-kwu

# Create a bot with @BotFather, then send /start to it to get your chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_IDS=
# Who may approve payments / change orders: telegramUserId=dashboard-email, comma separated
TELEGRAM_ADMINS=

DASHBOARD_URL=http://localhost:3001
POLL_INTERVAL_SECONDS=15

# Matches docker-compose.dev.yml rustfs service (bun run infra:start)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfs-dev-secret
S3_BUCKET=web-kwu
