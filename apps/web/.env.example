NODE_ENV=development

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3001

# Matches docker-compose.dev.yml (bun run infra:start)
DATABASE_URL=postgresql://postgres:password@localhost:5432/web-kwu

# Seed user for `bun run db:seed` (optional in development, password required in production)
SEED_ADMIN_NAME=Admin
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Matches docker-compose.dev.yml rustfs service (bun run infra:start)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=rustfsadmin
S3_SECRET_ACCESS_KEY=rustfs-dev-secret
S3_BUCKET=web-kwu
