# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=1)
DATABASE_URL=

# Bot token from @BotFather.
# @type=string(minLength=1)
TELEGRAM_BOT_TOKEN=

# Chats that receive notifications, comma separated (users or groups).
# Send /start to the bot to see a chat's id; empty only logs a warning.
# @public @optional
TELEGRAM_CHAT_IDS=

# Telegram users allowed to approve/reject payments and change orders, batches and
# vouchers, each mapped to the dashboard account recorded as the actor:
# "telegramUserId=email,…". Send /start to the bot to see your user id.
# @public @optional
TELEGRAM_ADMINS=

# Origin of the admin dashboard, used for links in messages.
# @public @type=url
DASHBOARD_URL=

# How often the database is checked for new orders and payment proofs.
# @public @type=number(min=5)
POLL_INTERVAL_SECONDS=15

# Object storage holding payment proofs (same values as apps/web). When unset,
# notifications link to the review page without attaching the proof photo.
# @public @optional @type=url
S3_ENDPOINT=
# @public
S3_REGION=us-east-1
# @public @optional
S3_ACCESS_KEY_ID=
# @optional
S3_SECRET_ACCESS_KEY=
# @public
S3_BUCKET=web-kwu
