# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# @generateTsTypes(path=./src/env.ts, exposeEnv=local)
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public origin of the app; it appears in rendered pages (canonical/Open Graph URLs), so it is not sensitive.
# @public @type=url
BETTER_AUTH_URL=

# Canonical public origin for SEO: canonical links, Open Graph URLs and the sitemap.
# Defaults to the auth URL; set it when the storefront is served from another domain.
# @public @type=url
SITE_URL=$BETTER_AUTH_URL

# @type=string(minLength=1)
DATABASE_URL=

# Seed account for `bun run db:seed`. Name and email show up in normal
# responses (session, dashboard), so they must not be flagged as leaks.
# @public @optional
SEED_ADMIN_NAME=
# @public @optional @type=email
SEED_ADMIN_EMAIL=
# @optional
SEED_ADMIN_PASSWORD=

# S3-compatible object storage (RustFS in docker-compose.dev.yml) for payment proofs.
# The bucket is private; files are served through short-lived presigned URLs.
# Presigned URLs embed the endpoint and access key id, so both are public.
# @public @type=url
S3_ENDPOINT=
# @public
S3_REGION=us-east-1
# @public
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# @public
S3_BUCKET=web-kwu
